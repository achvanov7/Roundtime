<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roundtime" Width="1180" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI"
        Foreground="#EDF2F7" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary>
          <SolidColorBrush x:Key="PanelBrush" Color="#192637"/>
          <SolidColorBrush x:Key="SurfaceBrush" Color="#223044"/>
          <SolidColorBrush x:Key="ButtonBorderBrush" Color="#435267"/>
          <SolidColorBrush x:Key="CanvasBrush" Color="#111B29"/>
          <SolidColorBrush x:Key="AlternateBrush" Color="#26354A"/>
          <SolidColorBrush x:Key="ActiveBrush" Color="#293B4B"/>
          <SolidColorBrush x:Key="ButtonBrush" Color="#2A394D"/>
          <SolidColorBrush x:Key="HoverBrush" Color="#2B3B50"/>
          <SolidColorBrush x:Key="SelectionBrush" Color="#34445A"/>
          <SolidColorBrush x:Key="DividerBrush" Color="#39495E"/>
          <SolidColorBrush x:Key="InputBorderBrush" Color="#4E6077"/>
          <SolidColorBrush x:Key="InputSelectionBrush" Color="#52647A"/>
          <SolidColorBrush x:Key="AccentBrush" Color="#C9F36B"/>
          <SolidColorBrush x:Key="TimerFaceBrush" Color="#F2F5F8"/>
          <SolidColorBrush x:Key="TimerProgressBrush" Color="#527B32"/>
          <SolidColorBrush x:Key="TimerTrackBrush" Color="#DAE1E8"/>
        </ResourceDictionary>
      </ResourceDictionary.MergedDictionaries>
      <ResourceDictionary x:Key="ForestPalette">
        <SolidColorBrush x:Key="CanvasBrush" Color="#14241D"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#1C3027"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#263D31"/>
        <SolidColorBrush x:Key="AlternateBrush" Color="#2A4336"/>
        <SolidColorBrush x:Key="ActiveBrush" Color="#304838"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#30483C"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#344F42"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#3D5748"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#3C5548"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#4D6B5A"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#597966"/>
        <SolidColorBrush x:Key="InputSelectionBrush" Color="#516E5D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#F1D287"/>
        <SolidColorBrush x:Key="TimerFaceBrush" Color="#F0F5E9"/>
        <SolidColorBrush x:Key="TimerProgressBrush" Color="#527548"/>
        <SolidColorBrush x:Key="TimerTrackBrush" Color="#D8E4CF"/>
      </ResourceDictionary>
      <ResourceDictionary x:Key="PlumPalette">
        <SolidColorBrush x:Key="CanvasBrush" Color="#241C2C"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#302439"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#3D2D48"/>
        <SolidColorBrush x:Key="AlternateBrush" Color="#432F50"/>
        <SolidColorBrush x:Key="ActiveBrush" Color="#4A3554"/>
        <SolidColorBrush x:Key="ButtonBrush" Color="#493651"/>
        <SolidColorBrush x:Key="HoverBrush" Color="#513C5C"/>
        <SolidColorBrush x:Key="SelectionBrush" Color="#5D4569"/>
        <SolidColorBrush x:Key="DividerBrush" Color="#53415E"/>
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#6C5477"/>
        <SolidColorBrush x:Key="InputBorderBrush" Color="#846C90"/>
        <SolidColorBrush x:Key="InputSelectionBrush" Color="#73577D"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#EABBEB"/>
        <SolidColorBrush x:Key="TimerFaceBrush" Color="#F6EDF7"/>
        <SolidColorBrush x:Key="TimerProgressBrush" Color="#815288"/>
        <SolidColorBrush x:Key="TimerTrackBrush" Color="#E8D9EB"/>
      </ResourceDictionary>
      <SolidColorBrush x:Key="Muted" Color="#B0BCCB"/>
      <Style x:Key="TimerCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Padding" Value="24,16"/>
        <Setter Property="TextElement.Foreground" Value="#F2F6FA"/>
        <Style.Triggers>
          <Trigger Property="Grid.Row" Value="0">
            <Setter Property="Background" Value="{DynamicResource TimerFaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TimerFaceBrush}"/>
            <Setter Property="TextElement.Foreground" Value="#16263A"/>
          </Trigger>
        </Style.Triggers>
      </Style>
      <Style x:Key="TimerReadout" TargetType="Viewbox">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="StretchDirection" Value="DownOnly"/>
        <Setter Property="MaxHeight" Value="74"/>
        <Style.Triggers>
          <DataTrigger Binding="{Binding Path=(Grid.Row), RelativeSource={RelativeSource AncestorType=Border}}" Value="0">
            <Setter Property="MaxHeight" Value="96"/>
          </DataTrigger>
        </Style.Triggers>
      </Style>
      <Style TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}"/>
        <Setter Property="Foreground" Value="#F5F7FA"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Grid>
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                  <ContentPresenter x:Name="ButtonContent" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
                <Border x:Name="FocusRing" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter TargetName="Surface" Property="BorderBrush" Value="Transparent"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#9DAEC2"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="MeetingAction" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="MinHeight" Value="56"/>
        <Setter Property="Padding" Value="12,10"/>
      </Style>
      <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource CanvasBrush}"/>
        <Setter Property="Foreground" Value="#F3F6FA"/>
        <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource InputSelectionBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TextBox">
              <Grid>
                <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                  <ScrollViewer x:Name="PART_ContentHost"/>
                </Border>
                <Border x:Name="InputFocus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="10" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#8B9CB2"/></Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFocus" Property="Visibility" Value="Visible"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="#DCE4EE"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="CheckBox">
              <Grid Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" Background="{DynamicResource CanvasBrush}" BorderBrush="#8B9CB2" BorderThickness="1" VerticalAlignment="Center">
                  <Path x:Name="CheckMark" Data="M 3,7 L 6,10 L 11,4" Stroke="{DynamicResource CanvasBrush}" StrokeThickness="1.5" Visibility="Collapsed"/>
                </Border>
                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                <Border x:Name="CheckFocus" Grid.ColumnSpan="2" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="4" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#DCE4EE"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#EDF2F7"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFocus" Property="Visibility" Value="Visible"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ProgressBar">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ProgressBar">
              <Grid x:Name="PART_Track">
                <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
                <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TabControl">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabControl">
              <Grid KeyboardNavigation.TabNavigation="Local">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TabPanel IsItemsHost="True" Margin="24,0,24,8" KeyboardNavigation.DirectionalNavigation="Contained"/>
                <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" ClipToBounds="True">
                  <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
                </Border>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="#EDF2F7"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="TabItem">
              <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="TabLabel" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                  TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="14" TextElement.FontWeight="Medium"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceBrush}"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                  <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ActiveBrush}"/>
                  <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="MinHeight" Value="64"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
              <Grid>
                <Border x:Name="ItemBorder" CornerRadius="8" Background="{DynamicResource SurfaceBrush}" BorderBrush="Transparent" BorderThickness="1" Padding="12,8">
                  <ContentPresenter VerticalAlignment="Center"/>
                </Border>
                <Border x:Name="RowFocus" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}"/></Trigger>
                <DataTrigger Binding="{Binding Status}" Value="Speaking now"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource ActiveBrush}"/></DataTrigger>
                <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9DAEC2"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowFocus" Property="Visibility" Value="Visible"/></Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SavedRosterItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="MinHeight" Value="38"/>
      </Style>
      <DataTemplate x:Key="SavedRosterName">
        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
      </DataTemplate>
      <Style x:Key="SpeakerGrip" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Cursor" Value="SizeAll"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="24,16,24,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Image x:Name="BrandMark" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="Roundtime"/>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Roundtime" FontSize="24" FontWeight="Medium"/>
        <TextBlock Text="Time for every voice" FontSize="13" Foreground="{StaticResource Muted}"/>
      </StackPanel>
    </Grid>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectedIndex="0" AutomationProperties.Name="Roundtime workspace">
      <TabItem x:Name="MeetingTab" Header="Meeting">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Padding="24,16,24,12" AutomationProperties.Name="Meeting workspace">
          <!-- Use the viewport to size the queue, with a minimum for compact windows. -->
          <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinWidth="928" MaxWidth="1180" MinHeight="490">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="16">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,16">
                    <DockPanel><TextBlock Text="Speaker queue" FontSize="18" FontWeight="Medium"/><TextBlock x:Name="QueueCount" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="18"/></DockPanel>
                    <TextBlock Text="Drag ≡ to reorder this meeting" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <DockPanel Grid.Row="1" Margin="0,0,0,16">
                    <TextBlock Text="Team" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <ComboBox x:Name="MeetingTeam" ItemTemplate="{StaticResource SavedRosterName}" Foreground="#16263A" MinHeight="36" Padding="8,4" VerticalContentAlignment="Center"
                              AutomationProperties.Name="Meeting team"/>
                  </DockPanel>
                  <Grid Grid.Row="2" MinHeight="80">
                    <ListBox x:Name="SpeakerList" Background="Transparent" BorderThickness="0" Foreground="#EDF2F7" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Speaker queue">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border x:Name="SpeakerDragHandle" Style="{StaticResource SpeakerGrip}" ToolTip="Drag to reorder waiting speakers">
                              <TextBlock Text="≡" Foreground="#9DAEC2" FontSize="18" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Border>
                            <StackPanel Grid.Column="1">
                              <TextBlock x:Name="QueueSpeakerName" Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                              <TextBlock x:Name="QueueStatus" Text="{Binding Status}" FontSize="12" Margin="0,4,0,0">
                                <TextBlock.Style>
                                  <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                                  </Style>
                                </TextBlock.Style>
                              </TextBlock>
                            </StackPanel>
                          </Grid>
                          <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Status}" Value="Speaking now">
                              <Setter TargetName="SpeakerDragHandle" Property="Visibility" Value="Hidden"/>
                              <Setter TargetName="QueueStatus" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                          </DataTemplate.Triggers>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyQueue" VerticalAlignment="Center" Margin="8" IsHitTestVisible="False">
                      <TextBlock x:Name="EmptyQueueTitle" Text="Choose a team" FontSize="16" TextAlignment="Center"/>
                      <TextBlock x:Name="EmptyQueueHint" Text="Manage saved rosters in the Teams tab." TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="3" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Content="↑ Up" Padding="8,8" ToolTip="Move selected waiting speaker up"/>
                    <Button x:Name="DownButton" Grid.Column="1" Content="↓ Down" Margin="4,0" Padding="8,8" ToolTip="Move selected waiting speaker down"/>
                    <Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" Padding="8,8" Foreground="#FFC5B4" ToolTip="Remove the selected speaker from this meeting"/>
                  </Grid>
                </Grid>
              </Border>
              <StackPanel Grid.Column="2" VerticalAlignment="Top">
                <Grid Margin="0,0,0,16">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Current speaker" Foreground="{StaticResource Muted}" FontSize="13" FontWeight="Medium"/>
                  <TextBlock x:Name="ProgressLabel" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="13"/>
                  <TextBlock x:Name="CurrentName" Grid.Row="1" Text="Ready for your team" FontSize="42" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                </Grid>
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="152"/><RowDefinition Height="12"/><RowDefinition Height="128"/></Grid.RowDefinitions>
                  <Border x:Name="PersonalCard" Style="{StaticResource TimerCard}">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock Text="Personal time" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="PersonalHint" Text="Progress, plans, blockers" FontSize="13" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Viewbox Grid.Column="1" Style="{StaticResource TimerReadout}">
                        <TextBlock x:Name="PersonalTime" Text="01:30" FontSize="72" Typography.NumeralAlignment="Tabular"/>
                      </Viewbox>
                      <ProgressBar x:Name="PersonalProgress" Grid.Row="1" Grid.ColumnSpan="2" Height="4" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="1" Foreground="{DynamicResource TimerProgressBrush}" Background="{DynamicResource TimerTrackBrush}" BorderThickness="0"/>
                    </Grid>
                  </Border>
                  <Border x:Name="SharedCard" Grid.Row="2" Style="{StaticResource TimerCard}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                        <TextBlock x:Name="SharedTitle" Text="Shared discussion" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="SharedHint" Text="For overtime and questions between speakers" FontSize="13" Opacity="0.8" Margin="0,6,0,0" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Viewbox Grid.Column="1" Style="{StaticResource TimerReadout}">
                        <TextBlock x:Name="SharedTime" Text="10:00" FontSize="72" Typography.NumeralAlignment="Tabular"/>
                      </Viewbox>
                    </Grid>
                  </Border>
                </Grid>
                <UniformGrid Columns="4" Margin="0,16,0,0">
                  <Button x:Name="StartButton" Content="_Start meeting" Style="{StaticResource MeetingAction}" Background="{DynamicResource AccentBrush}" Foreground="#172435" BorderBrush="Transparent" Margin="0,0,8,0"/>
                  <Grid Margin="0,0,8,0">
                    <Button x:Name="DiscussButton" Content="Start _discussion" Style="{StaticResource MeetingAction}"/>
                    <Button x:Name="ReturnButton" Content="Back to speaker" Style="{StaticResource MeetingAction}" Visibility="Collapsed"/>
                  </Grid>
                  <Button x:Name="NextButton" Content="_Next speaker →" Style="{StaticResource MeetingAction}" Margin="0,0,8,0"/>
                  <Button x:Name="ResetButton" Content="Reset" Style="{StaticResource MeetingAction}" Background="Transparent" BorderBrush="Transparent" Foreground="#B0BCCB"/>
                </UniformGrid>
              </StackPanel>
            </Grid>
            <TextBlock Grid.Row="1" Text="Alt+S start/pause · Alt+D discuss · Alt+N next speaker" Foreground="#9DAEC2" FontSize="12" Margin="0,12,0,0"/>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="TeamsTab" Header="Teams">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,12"
                      HorizontalContentAlignment="Stretch" AutomationProperties.Name="Team rosters">
          <Grid Height="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}" MinHeight="392" MaxWidth="900">
            <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="Saved teams" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <ListBox x:Name="TeamsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#EDF2F7"
                         ItemTemplate="{StaticResource SavedRosterName}" ItemContainerStyle="{StaticResource SavedRosterItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saved teams"/>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                  <TextBlock Text="Team name" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                  <TextBox x:Name="TeamNameInput" MaxLength="120" AutomationProperties.Name="Team name"/>
                  <UniformGrid Columns="2" Margin="0,8,0,0">
                    <Button x:Name="AddTeamButton" Content="Add team" Margin="0,0,4,0" Padding="8,8" ToolTip="Create a team with the entered name"/>
                    <Button x:Name="RenameTeamButton" Content="Rename" Margin="4,0,0,0" Padding="8,8" ToolTip="Rename the selected team"/>
                  </UniformGrid>
                  <Button x:Name="DeleteTeamButton" Content="Delete team" Foreground="#FFC5B4" Background="Transparent" Margin="0,8,0,0" ToolTip="Delete the selected team and its saved roster"/>
                </StackPanel>
              </Grid>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="16" Padding="16">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,12">
                  <TextBlock Text="Saved roster" FontSize="13" Foreground="{StaticResource Muted}"/>
                  <TextBlock x:Name="RosterHeading" Text="Choose a team" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <ListBox x:Name="RosterList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="#EDF2F7" AllowDrop="True"
                         ItemContainerStyle="{StaticResource SavedRosterItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Saved roster">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border x:Name="SpeakerDragHandle" Style="{StaticResource SpeakerGrip}" ToolTip="Drag to reorder the saved roster">
                          <TextBlock Text="≡" Foreground="#9DAEC2" FontSize="18" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Name}"/>
                        <TextBlock x:Name="PersonalOverride" Grid.Column="2" Text="{Binding PersonalSeconds, StringFormat={}{0} s}"
                                   Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center" ToolTip="Custom personal time"/>
                      </Grid>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding PersonalSeconds}" Value="{x:Null}">
                          <Setter TargetName="PersonalOverride" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="132"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock Text="Speaker name" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                      <TextBox x:Name="MemberNameInput" MaxLength="120" AutomationProperties.Name="Saved speaker name"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="Personal time" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,6"/>
                      <TextBox x:Name="MemberPersonalTimeInput" MaxLength="6" AutomationProperties.Name="Personal time override"
                               ToolTip="Enter seconds or m:ss. Leave blank for the meeting default."/>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Enter seconds or m:ss. Blank uses the default. Press Enter to save the selected speaker." TextWrapping="Wrap" FontSize="12"
                             Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="SaveMemberButton" Content="Save speaker" Background="{DynamicResource AccentBrush}" Foreground="#172435" BorderBrush="Transparent"
                            Margin="0,0,8,0" Padding="10,8" ToolTip="Save the selected speaker's name and personal time"/>
                    <Button x:Name="AddMemberButton" Content="Add speaker" Padding="10,8"/>
                    <TextBlock x:Name="MemberSaveStatus" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </WrapPanel>
                  <WrapPanel Margin="0,8,0,0">
                    <Button x:Name="MoveMemberUpButton" Content="↑ Up" Margin="0,0,8,0" Padding="10,8" ToolTip="Move the selected speaker up in the saved roster"/>
                    <Button x:Name="MoveMemberDownButton" Content="↓ Down" Margin="0,0,8,0" Padding="10,8" ToolTip="Move the selected speaker down in the saved roster"/>
                    <Button x:Name="RemoveMemberButton" Content="Remove" Foreground="#FFC5B4" Padding="10,8" ToolTip="Remove the selected speaker from this saved roster"/>
                  </WrapPanel>
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="RulesTab" Header="Rules &amp; rankings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Rules and rankings">
          <StackPanel Margin="24,16,24,16" MaxWidth="820">
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Meeting rules" FontSize="18" FontWeight="Medium"/>
                <TextBlock Text="Shared time covers questions and overtime. It starts when the personal timer expires or you select Start discussion." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,16"/>
                <WrapPanel>
                  <TextBlock Text="Per speaker" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
                  <TextBox x:Name="PersonalSetting" Width="64" MaxLength="6" Text="1:30" Margin="0,0,16,8" AutomationProperties.Name="Personal duration in minutes and seconds"/>
                  <TextBlock Text="Shared" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
                  <TextBox x:Name="SharedSetting" Width="72" MaxLength="6" Text="10:00" Margin="0,0,12,8" AutomationProperties.Name="Shared duration in minutes and seconds"/>
                  <Button x:Name="ApplySettingsButton" Content="Apply" Margin="0,0,24,8" Padding="12,8"/>
                  <CheckBox x:Name="TopmostCheck" Content="Always on top" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock x:Name="SettingsHint" Text="Enter m:ss or whole minutes." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Margin="0,12,0,0" Padding="16">
              <StackPanel>
                <TextBlock Text="Overtime rankings" FontSize="18" FontWeight="Medium"/>
                <TextBlock Text="All-time percentage of completed turns where the personal timer expired." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <TextBlock x:Name="EmptyOvertimeHistory" Text="Rankings appear after the first completed turn." Foreground="{StaticResource Muted}" FontSize="13"/>
                <DataGrid x:Name="OvertimeTable" AutomationProperties.Name="Overtime rankings" MaxHeight="288"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" Visibility="Collapsed" FontSize="13" RowHeight="32"
                          Background="{DynamicResource PanelBrush}" RowBackground="{DynamicResource SurfaceBrush}" AlternatingRowBackground="{DynamicResource AlternateBrush}" Foreground="#EDF2F7"
                          BorderBrush="{DynamicResource DividerBrush}" GridLinesVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <DataGrid.Resources>
                    <Style x:Key="TableText" TargetType="TextBlock">
                      <Setter Property="Margin" Value="10,0"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style x:Key="SpeakerText" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                      <Setter Property="ToolTip" Value="{Binding Name}"/>
                    </Style>
                  </DataGrid.Resources>
                  <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                      <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                      <Setter Property="Padding" Value="10,8"/>
                      <Setter Property="FontWeight" Value="Medium"/>
                    </Style>
                  </DataGrid.ColumnHeaderStyle>
                  <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                      <Setter Property="BorderBrush" Value="Transparent"/>
                      <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter Property="Background" Value="{DynamicResource SelectionBrush}"/>
                          <Setter Property="Foreground" Value="#EDF2F7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </DataGrid.CellStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Speaker" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource SpeakerText}"/>
                    <DataGridTextColumn Header="Team" Width="*" Binding="{Binding TeamName}" ElementStyle="{StaticResource SpeakerText}"/>
                    <DataGridTextColumn Header="Overtime rate" Width="115" Binding="{Binding OvertimeRate, StringFormat=P1}" ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Overtime turns" Width="115" Binding="{Binding OvertimeTurns}" ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Total turns" Width="96" Binding="{Binding CompletedTurns}" ElementStyle="{StaticResource TableText}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="SettingsTab" Header="Settings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Settings">
          <Grid Margin="24,16,24,16" MinWidth="548" MaxWidth="820" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="3*" MinWidth="336"/>
              <ColumnDefinition Width="12"/>
              <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>
            <Border Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Timer sounds" FontSize="18" FontWeight="Medium"/>
                <CheckBox x:Name="SoundCheck" Content="Play timer alerts" IsChecked="True" Margin="0,12,0,16" HorizontalAlignment="Left"/>
                <TextBlock Text="Overtime sound" FontSize="13" Margin="0,0,0,6"/>
                <WrapPanel>
                  <ComboBox x:Name="OvertimeSoundPicker" Width="192" MinHeight="34" Padding="8,4" Foreground="#16263A"
                            VerticalContentAlignment="Center" Margin="0,0,12,8" AutomationProperties.Name="Overtime sound"/>
                  <Button x:Name="TestSoundButton" Content="Test sound" Padding="12,8" Margin="0,0,0,8"/>
                </WrapPanel>
                <Grid HorizontalAlignment="Left" Width="304" Margin="0,8,0,0">
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Alert volume" FontSize="13"/>
                  <TextBlock Text="{Binding Value, ElementName=VolumeSlider, StringFormat={}{0:0}%}" FontSize="13"
                             Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/>
                  <Slider x:Name="VolumeSlider" Grid.Row="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1" IsSnapToTickEnabled="True"
                          LargeChange="10" SmallChange="1" IsMoveToPointEnabled="True" Margin="0,6,0,0" AutomationProperties.Name="Alert volume"/>
                </Grid>
              </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="12" Padding="16" VerticalAlignment="Top">
              <StackPanel>
                <TextBlock Text="Appearance" FontSize="18" FontWeight="Medium"/>
                <TextBlock Text="Color theme" FontSize="13" Margin="0,12,0,6"/>
                <ComboBox x:Name="ThemePicker" MinHeight="34" Padding="8,4" Foreground="#16263A"
                          VerticalContentAlignment="Center" AutomationProperties.Name="Color theme"/>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border x:Name="NoticeBorder" Grid.Row="2" Background="#493C2A" CornerRadius="8" Margin="24,0,24,12" Padding="12,8" Visibility="Collapsed">
      <DockPanel><Button x:Name="DismissNoticeButton" DockPanel.Dock="Right" Content="Dismiss" Padding="8,4" Margin="12,0,0,0"/><TextBlock x:Name="NoticeText" Foreground="#FFE3AC" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Border>
    <Canvas x:Name="QueueDragOverlay" Grid.RowSpan="3" IsHitTestVisible="False" ClipToBounds="True">
      <Border x:Name="QueueDropMarker" Height="2" CornerRadius="1" Background="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
      <Border x:Name="QueueDragPreview" MaxWidth="220" Padding="12,7" CornerRadius="8" Background="{DynamicResource ActiveBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Visibility="Collapsed">
        <TextBlock x:Name="QueueDragName" TextTrimming="CharacterEllipsis" FontWeight="SemiBold"/>
      </Border>
    </Canvas>
  </Grid>
</Window>
