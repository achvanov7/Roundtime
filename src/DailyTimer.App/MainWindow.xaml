<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Roundtime" Width="1180" Height="820" MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#111B29" FontFamily="Segoe UI"
        Foreground="#EDF2F7" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#B0BCCB"/>
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2A394D"/>
      <Setter Property="Foreground" Value="#F5F7FA"/>
      <Setter Property="BorderBrush" Value="#435267"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="Medium"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="ButtonContent" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              </Border>
              <Border x:Name="FocusRing" BorderBrush="#C9F36B" BorderThickness="2" CornerRadius="10" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.88"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.72"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Background" Value="#223044"/><Setter TargetName="Surface" Property="BorderBrush" Value="Transparent"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#9DAEC2"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#111B29"/>
      <Setter Property="Foreground" Value="#F3F6FA"/>
      <Setter Property="CaretBrush" Value="#C9F36B"/>
      <Setter Property="BorderBrush" Value="#4E6077"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SelectionBrush" Value="#52647A"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="InputSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                <ScrollViewer x:Name="PART_ContentHost"/>
              </Border>
              <Border x:Name="InputFocus" BorderBrush="#C9F36B" BorderThickness="2" CornerRadius="10" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="InputSurface" Property="BorderBrush" Value="#8B9CB2"/></Trigger>
              <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputFocus" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#DCE4EE"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border x:Name="CheckSurface" Width="16" Height="16" CornerRadius="4" Background="#111B29" BorderBrush="#8B9CB2" BorderThickness="1" VerticalAlignment="Center">
                <Path x:Name="CheckMark" Data="M 3,7 L 6,10 L 11,4" Stroke="#111B29" StrokeThickness="1.5" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
              <Border x:Name="CheckFocus" Grid.ColumnSpan="2" BorderBrush="#C9F36B" BorderThickness="2" CornerRadius="4" Margin="-4" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True"><Setter TargetName="CheckSurface" Property="Background" Value="#DCE4EE"/><Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckSurface" Property="BorderBrush" Value="#EDF2F7"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFocus" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ProgressBar">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="PART_Track">
              <Border Background="{TemplateBinding Background}" CornerRadius="2"/>
              <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left"/>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabControl">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <Grid KeyboardNavigation.TabNavigation="Local">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
              <TabPanel IsItemsHost="True" Margin="24,0,24,8" KeyboardNavigation.DirectionalNavigation="Contained"/>
              <Border Grid.Row="1" BorderBrush="#39495E" BorderThickness="0,1,0,0" ClipToBounds="True">
                <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
              </Border>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Foreground" Value="#EDF2F7"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter x:Name="TabLabel" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"
                                TextElement.Foreground="{StaticResource Muted}" TextElement.FontSize="14" TextElement.FontWeight="Medium"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#223044"/></Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabSurface" Property="Background" Value="#293B4B"/>
                <Setter TargetName="TabLabel" Property="TextElement.Foreground" Value="#C9F36B"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabSurface" Property="BorderBrush" Value="#C9F36B"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="MinHeight" Value="64"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid>
              <Border x:Name="ItemBorder" CornerRadius="8" Background="#223044" BorderBrush="Transparent" BorderThickness="1" Padding="12,8">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="RowFocus" BorderBrush="#C9F36B" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#2B3B50"/></Trigger>
              <DataTrigger Binding="{Binding Status}" Value="Speaking now"><Setter TargetName="ItemBorder" Property="Background" Value="#293B4B"/></DataTrigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="#9DAEC2"/></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RowFocus" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Grid Margin="24,16,24,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Image x:Name="BrandMark" Width="40" Height="40" Margin="0,0,12,0" AutomationProperties.Name="Roundtime"/>
      <StackPanel Grid.Column="1">
        <TextBlock Text="Roundtime" FontSize="24" FontWeight="Medium"/>
        <TextBlock Text="Time for every voice" FontSize="13" Foreground="{StaticResource Muted}"/>
      </StackPanel>
      <Border Grid.Column="2" Background="Transparent" CornerRadius="8" Padding="0,8" VerticalAlignment="Center">
        <TextBlock x:Name="SessionState" Text="Ready to start" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Muted}"/>
      </Border>
    </Grid>
    <TabControl x:Name="WorkspaceTabs" Grid.Row="1" SelectedIndex="0" AutomationProperties.Name="Roundtime workspace">
      <TabItem x:Name="MeetingTab" Header="Meeting">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" AutomationProperties.Name="Meeting workspace">
          <Grid Margin="24,16,24,12" MinWidth="928" MinHeight="490">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Background="#192637" CornerRadius="16" Padding="16">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Margin="0,0,0,16">
                    <DockPanel><TextBlock Text="Today's speakers" FontSize="18" FontWeight="Medium"/><TextBlock x:Name="QueueCount" Text="0" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="18"/></DockPanel>
                    <TextBlock Text="Edit names inline · drag to reorder" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                  </StackPanel>
                  <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="NewName" MaxLength="120" AutomationProperties.Name="New speaker name" ToolTip="Type a name and press Enter"/>
                    <Button x:Name="AddButton" Grid.Column="1" Content="_Add" Margin="8,0,0,0" Padding="12,8" ToolTip="Add speaker (Enter)"/>
                  </Grid>
                  <Grid Grid.Row="2" MinHeight="80">
                    <ListBox x:Name="SpeakerList" Background="Transparent" BorderThickness="0" Foreground="#EDF2F7" AllowDrop="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Speaker queue">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBlock Text="≡" Foreground="#9DAEC2" FontSize="18" VerticalAlignment="Center" Cursor="SizeAll" ToolTip="Drag to reorder waiting speakers"/>
                            <StackPanel Grid.Column="1">
                              <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxLength="120" BorderThickness="0" Background="Transparent" Padding="2,2" FontSize="15" AutomationProperties.Name="Speaker name" ToolTip="Click to edit name"/>
                              <TextBlock Text="{Binding Status}" Foreground="{Binding StatusBrush}" FontSize="12" Margin="2,4,0,0"/>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel x:Name="EmptyQueue" VerticalAlignment="Center" Margin="8" IsHitTestVisible="False">
                      <TextBlock Text="Who’s joining today?" FontSize="16" TextAlignment="Center"/>
                      <TextBlock Text="Add names above&#10;Your queue is saved for next time" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                  </Grid>
                  <Grid Grid.Row="3" Margin="0,12,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Button x:Name="UpButton" Content="↑ Up" Padding="8,8" ToolTip="Move selected waiting speaker up"/>
                    <Button x:Name="DownButton" Grid.Column="1" Content="↓ Down" Margin="4,0" Padding="8,8" ToolTip="Move selected waiting speaker down"/>
                    <Button x:Name="RemoveButton" Grid.Column="2" Content="Remove" Padding="8,8" Foreground="#FFC5B4" ToolTip="Remove selected speaker"/>
                  </Grid>
                  <Button x:Name="ShuffleButton" Grid.Row="4" Content="Shuffle remaining speakers" ToolTip="Only people who haven't started are shuffled"/>
                </Grid>
              </Border>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="112"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Border x:Name="PersonalCard" Background="#F2F5F8" CornerRadius="16" Padding="24,24">
                  <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel><TextBlock Text="Current speaker" Foreground="#566579" FontSize="12" FontWeight="Medium"/><TextBlock x:Name="ProgressLabel" HorizontalAlignment="Right" Foreground="#566579" FontSize="12"/></DockPanel>
                    <TextBlock x:Name="CurrentName" Grid.Row="1" Text="Ready for your team" Foreground="#16263A" FontSize="32" FontWeight="Medium" TextTrimming="CharacterEllipsis" Margin="0,8,0,0"/>
                    <Viewbox Grid.Row="2" Stretch="Uniform" HorizontalAlignment="Left" MaxHeight="160" Margin="0,16,0,16">
                      <TextBlock x:Name="PersonalTime" Text="01:30" Foreground="#16263A" FontFamily="Segoe UI" FontSize="112" FontWeight="Normal" Typography.NumeralAlignment="Tabular"/>
                    </Viewbox>
                    <ProgressBar x:Name="PersonalProgress" Grid.Row="3" Height="4" Minimum="0" Maximum="1" Value="1" Foreground="#527B32" Background="#DAE1E8" BorderThickness="0"/>
                    <TextBlock x:Name="PersonalHint" Grid.Row="4" Text="Progress, plans, blockers" Foreground="#566579" FontSize="12" Margin="0,16,0,0" TextWrapping="Wrap"/>
                  </Grid>
                </Border>
                <Border x:Name="SharedCard" Grid.Row="2" Background="#223044" CornerRadius="12" Padding="20,16" BorderBrush="#39495E" BorderThickness="1">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                      <TextBlock x:Name="SharedTitle" Text="Shared discussion" Foreground="{StaticResource Muted}" FontSize="12" FontWeight="Medium"/>
                      <TextBlock x:Name="SharedHint" Text="For overtime and questions between speakers" Foreground="#B0BCCB" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock x:Name="SharedTime" Grid.Column="1" Text="10:00" FontFamily="Segoe UI" FontSize="44" FontWeight="Normal" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
                  </Grid>
                </Border>
                <WrapPanel Grid.Row="4">
                  <Button x:Name="StartButton" Content="_Start meeting" Background="#C9F36B" Foreground="#172435" BorderBrush="Transparent" MinWidth="128" Margin="0,0,8,8" Padding="16,12"/>
                  <Button x:Name="DiscussButton" Content="End speech / _Discuss" Margin="0,0,8,8" Padding="16,12"/>
                  <Button x:Name="NextButton" Content="_Next speaker →" Margin="0,0,8,8" Padding="16,12"/>
                  <Button x:Name="ResetButton" Content="Reset" Background="Transparent" BorderBrush="Transparent" Foreground="#B0BCCB" Padding="12,12" Margin="0,0,0,8"/>
                </WrapPanel>
              </Grid>
            </Grid>
            <TextBlock Grid.Row="1" Text="Alt+S start/pause · Alt+D discuss · Alt+N next speaker" Foreground="#9DAEC2" FontSize="12" Margin="0,12,0,0"/>
          </Grid>
        </ScrollViewer>
      </TabItem>
      <TabItem x:Name="RulesTab" Header="Rules &amp; rankings">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch" AutomationProperties.Name="Rules and rankings">
          <StackPanel Margin="24,16,24,16" MaxWidth="820">
            <Border Background="#192637" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock Text="Meeting rules" FontSize="18" FontWeight="Medium"/>
                <TextBlock Text="Shared time covers questions and overtime. It starts when the personal timer expires or you select End speech / Discuss." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,16"/>
                <WrapPanel>
                  <TextBlock Text="Per speaker" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
                  <TextBox x:Name="PersonalSetting" Width="64" MaxLength="6" Text="1:30" Margin="0,0,16,8" AutomationProperties.Name="Personal duration in minutes and seconds"/>
                  <TextBlock Text="Shared" VerticalAlignment="Center" Margin="0,0,8,8" FontSize="12"/>
                  <TextBox x:Name="SharedSetting" Width="72" MaxLength="6" Text="10:00" Margin="0,0,12,8" AutomationProperties.Name="Shared duration in minutes and seconds"/>
                  <Button x:Name="ApplySettingsButton" Content="Apply" Margin="0,0,24,8" Padding="12,8"/>
                  <CheckBox x:Name="SoundCheck" Content="Sound" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,8"/>
                  <Button x:Name="TestSoundButton" Content="Test sound" Margin="0,0,24,8" Padding="12,8"/>
                  <CheckBox x:Name="TopmostCheck" Content="Always on top" VerticalAlignment="Center" Margin="0,0,0,8"/>
                </WrapPanel>
                <TextBlock x:Name="SettingsHint" Text="Enter m:ss or whole minutes. Sound and window preferences apply immediately." FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
            <Border Background="#192637" CornerRadius="12" Margin="0,12,0,0" Padding="16">
              <StackPanel>
                <TextBlock Text="Overtime rankings" FontSize="18" FontWeight="Medium"/>
                <TextBlock Text="All-time percentage of completed turns where the personal timer expired." Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap" Margin="0,6,0,12"/>
                <TextBlock x:Name="EmptyOvertimeHistory" Text="Rankings appear after the first completed turn." Foreground="{StaticResource Muted}" FontSize="13"/>
                <DataGrid x:Name="OvertimeTable" AutomationProperties.Name="Overtime rankings" MaxHeight="288"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeRows="False"
                          HeadersVisibility="Column" SelectionMode="Single" Visibility="Collapsed" FontSize="13" RowHeight="32"
                          Background="#192637" RowBackground="#223044" AlternatingRowBackground="#26354A" Foreground="#EDF2F7"
                          BorderBrush="#39495E" GridLinesVisibility="None" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                  <DataGrid.Resources>
                    <Style x:Key="TableText" TargetType="TextBlock">
                      <Setter Property="Margin" Value="10,0"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                    <Style x:Key="SpeakerText" TargetType="TextBlock" BasedOn="{StaticResource TableText}">
                      <Setter Property="ToolTip" Value="{Binding Name}"/>
                    </Style>
                  </DataGrid.Resources>
                  <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                      <Setter Property="Background" Value="#192637"/>
                      <Setter Property="Foreground" Value="{StaticResource Muted}"/>
                      <Setter Property="Padding" Value="10,8"/>
                      <Setter Property="FontWeight" Value="Medium"/>
                    </Style>
                  </DataGrid.ColumnHeaderStyle>
                  <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                      <Setter Property="BorderBrush" Value="Transparent"/>
                      <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter Property="Background" Value="#34445A"/>
                          <Setter Property="Foreground" Value="#EDF2F7"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#C9F36B"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </DataGrid.CellStyle>
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Speaker" Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource SpeakerText}"/>
                    <DataGridTextColumn Header="Overtime rate" Width="115" Binding="{Binding OvertimeRate, StringFormat=P1}" ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Overtime turns" Width="115" Binding="{Binding OvertimeTurns}" ElementStyle="{StaticResource TableText}"/>
                    <DataGridTextColumn Header="Total turns" Width="96" Binding="{Binding CompletedTurns}" ElementStyle="{StaticResource TableText}"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
    <Border x:Name="NoticeBorder" Grid.Row="2" Background="#493C2A" CornerRadius="8" Margin="24,0,24,12" Padding="12,8" Visibility="Collapsed">
      <DockPanel><Button x:Name="DismissNoticeButton" DockPanel.Dock="Right" Content="Dismiss" Padding="8,4" Margin="12,0,0,0"/><TextBlock x:Name="NoticeText" Foreground="#FFE3AC" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel>
    </Border>
  </Grid>
</Window>
